{
  "name": "backend",
  "version": "1.0.0",
  "build": {
    "command": "npm ci --only=production",
    "dir": "."
  },
  "deploy": {
    "command": "npm start",
    "port": 3001
  },
  "envVars": {
    "NODE_ENV": "production",
    "PORT": "3001",
    "REDIS_URL": "${REDIS_CONNECTION_STRING}"
  }
}